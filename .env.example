# The Leaky Invoice - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit the .env file with real values to version control

# Required: CTF flag that participants will discover
LEAKY_INVOICE_FLAG=FLAG{your_actual_flag_here}

# Required: Secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
LEAKY_INVOICE_SECRET_KEY=your_long_random_secret_key_here

# Optional: Database path (defaults to leaky_invoices.db in app root)
LEAKY_INVOICE_DATABASE=/data/leaky_invoices.db

# Optional: Application configuration
FLASK_ENV=production
